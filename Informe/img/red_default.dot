// Red de 5 routers con el router default (tablas rutas_R*_v5.txt), conectado a cada router con un
// enlace punteado. Rdefault es la salida hacia el resto de Internet.
graph red_default {
    layout=neato;
    inputscale=72;
    pad=0.05;
    node [fontname="Latin Modern Roman,", fontsize=8.5, shape=ellipse, width=0.55, height=0.36, margin=0];
    edge [penwidth=0.8];

    R1 [label="R1\n8881", pos="0,0!"];
    R2 [label="R2\n8882", pos="95,0!"];
    R3 [label="R3\n8883", pos="190,38!"];
    R4 [label="R4\n8884", pos="190,-38!"];
    R5 [label="R5\n8885", pos="285,0!"];
    D [label="Rdefault\n7000", pos="126,-112!", width=0.75, style=filled, fillcolor=gray90];
    Internet [label="resto de\nInternet", pos="275,-112!", shape=plaintext, fontsize=8];

    R1 -- R2;
    R2 -- R3;
    R2 -- R4;
    R3 -- R5;
    R4 -- R5;
    D -- R1 [style=dashed, color=gray45];
    D -- R2 [style=dashed, color=gray45];
    D -- R3 [style=dashed, color=gray45];
    D -- R4 [style=dashed, color=gray45];
    D -- R5 [style=dashed, color=gray45];
    D -- Internet [style=dotted, color=gray45];
}
