// Red de 7 routers (tablas rutas_R*_v4.txt): la de 5 routers más R0, conectado a R1 y R2, y R6,
// conectado a R2 y R3. Los routers y enlaces nuevos van en gris.
graph red_7_routers {
    layout=neato;
    inputscale=72;
    pad=0.05;
    node [fontname="Latin Modern Roman,", fontsize=8.5, shape=ellipse, width=0.55, height=0.36, margin=0];
    edge [penwidth=0.8];

    R0 [label="R0\n8880", pos="47,62!", style=filled, fillcolor=gray90];
    R1 [label="R1\n8881", pos="0,0!"];
    R2 [label="R2\n8882", pos="95,0!"];
    R6 [label="R6\n8886", pos="142,85!", style=filled, fillcolor=gray90];
    R3 [label="R3\n8883", pos="190,38!"];
    R4 [label="R4\n8884", pos="190,-38!"];
    R5 [label="R5\n8885", pos="285,0!"];

    R1 -- R2;
    R2 -- R3;
    R2 -- R4;
    R3 -- R5;
    R4 -- R5;
    R0 -- R1 [color=gray45];
    R0 -- R2 [color=gray45];
    R6 -- R2 [color=gray45];
    R6 -- R3 [color=gray45];
}
